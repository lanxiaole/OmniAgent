# ============================================================
# OmniAgent 环境变量配置
# ============================================================
# 使用方法：复制本文件为 .env，然后填入你的实际配置。
#
# 核心原则：
#   1) LLM 和 Embedding 是两套完全独立的配置，互不干扰。
#   2) 每个值都直接对应 OpenAI 兼容接口的字段（base_url / api_key / model）。
#   3) 想换平台？直接修改对应三个值即可，不需要选"PROVIDER"。
# ============================================================


# ==================== 方案 A：全部使用阿里云百炼 ====================
# 适用场景：国内访问稳定、便宜、中文能力强
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-plus
# LLM_SUMMARIZER_MODEL=qwen-turbo  # 可选：不填则与 LLM_MODEL 相同
# LLM_TEMPERATURE=0.7  # 可选：默认 0.7

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024  # 可选：默认 1024，text-embedding-v3/v4 支持


# ==================== 方案 B：LLM 用 DeepSeek，Embedding 用百炼 ====================
# 适用场景：DeepSeek 推理能力强但不支持 Embedding，所以分开用
# 把上面 LLM_ 开头的 3 行替换为下面 3 行即可，其他保持不变：
#
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-v4-flash


# ==================== 方案 C：LLM 用 OpenAI ====================
# 适用场景：海外访问、需要 GPT 系列模型
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini


# ==================== 高德地图 API Key（可选） ====================
# 用于天气查询工具
# 获取地址：https://console.amap.com/dev/key/app
AMAP_API_KEY=your_amap_api_key_here


# ==================== 文件系统配置（可选） ====================
# 系统目录黑名单（逗号分隔），用于路径安全警告
# 默认值：/etc,/System,/boot,C:/Windows,C:/Program Files
# SYSTEM_DIRS=/etc,/System,/boot,C:/Windows,C:/Program Files


# ==================== 代码执行配置（可选） ====================
# 执行超时时间（秒），默认30
# EXECUTION_TIMEOUT=30
# 最大重试次数，默认3
# EXECUTION_MAX_RETRIES=3
# 执行工作目录，默认为 temp_exec
# EXECUTION_WORK_DIR=temp_exec
